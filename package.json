{
  "name": "school-photo-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:test": "bash scripts/db-test.sh",
    "db:introspect": "drizzle-kit pull",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run db:test",
    "start": "tsx src/server/import-server.ts",
    "e2e": "tsx scripts/e2e-parent-isolation.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.38.3",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
