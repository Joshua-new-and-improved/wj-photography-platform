# Application connection. NOTE the role: app_rw, not the table owner.
# Connecting as the owner would silently disable every row-level policy in
# migration 0008, and nothing would fail visibly. See db/README.md.
DATABASE_URL=postgres://app_rw@localhost:5432/spp
PG_POOL_MAX=10

# Migrations only. Never used by the running application.
MIGRATION_DATABASE_URL=postgres://app_owner@localhost:5432/spp

# Object storage. Region is a POPIA decision, not a latency one — architecture
# §3.2. af-south-1 keeps children's personal information in South Africa and
# avoids the s57(1)(d) prior-authorisation question entirely.
S3_REGION=af-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SESSION_COOKIE_SECRET=
DEFAULT_LOCALE=af
